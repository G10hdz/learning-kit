# Embeddings: provider local por default, nube opcional.
EMBEDDING_PROVIDER=ollama
OLLAMA_MODEL=bge-m3
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=text-embedding-3-large

# Vaults a indexar, separados por coma. Sin esto usa ~/Obsidian/MyVault.
VAULT_PATHS=/ruta/a/tu/vault

# CHROMA_PERSIST_DIR=~/.local/share/obsidian-embeddings/chroma
# CHUNK_MAX_CHARS=16000
